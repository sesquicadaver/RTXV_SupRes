if(NOT EXE OR NOT DEST)
  message(FATAL_ERROR "deploy_runtime: потрібні EXE і DEST")
endif()
if(NOT WINDEPLOYQT OR NOT EXISTS "${WINDEPLOYQT}")
  message(FATAL_ERROR "deploy_runtime: немає windeployqt")
endif()
if(NOT FFMPEG_BIN OR NOT EXISTS "${FFMPEG_BIN}")
  message(FATAL_ERROR "deploy_runtime: немає каталогу DLL FFmpeg")
endif()

if(CONFIG STREQUAL "Debug")
  set(qt_flag "--debug")
else()
  set(qt_flag "--release")
endif()
execute_process(
  COMMAND "${WINDEPLOYQT}" ${qt_flag} --no-translations "${EXE}"
  RESULT_VARIABLE qt_result)
if(NOT qt_result EQUAL 0)
  message(FATAL_ERROR "windeployqt завершився з кодом ${qt_result}")
endif()

get_filename_component(qt_bin "${WINDEPLOYQT}" DIRECTORY)
get_filename_component(qt_prefix "${qt_bin}" DIRECTORY)
set(qwindows "${qt_prefix}/plugins/platforms/qwindows.dll")
if(NOT EXISTS "${qwindows}")
  message(FATAL_ERROR "немає ${qwindows}. platforms/qwindows.dll має лежати в пакеті")
endif()
file(COPY "${qwindows}" DESTINATION "${DEST}/platforms")

file(GLOB ffmpeg_dlls "${FFMPEG_BIN}/*.dll")
if(NOT ffmpeg_dlls)
  message(FATAL_ERROR "у ${FFMPEG_BIN} немає DLL FFmpeg")
endif()
foreach(dll IN LISTS ffmpeg_dlls)
  file(COPY "${dll}" DESTINATION "${DEST}")
endforeach()

if(CUDA_BIN)
  file(GLOB cudart_dlls "${CUDA_BIN}/cudart64_*.dll")
  foreach(dll IN LISTS cudart_dlls)
    file(COPY "${dll}" DESTINATION "${DEST}")
  endforeach()
endif()

if(SDK)
  file(GLOB_RECURSE ngx_dlls "${SDK}/nvngx_vsr.dll")
  if(ngx_dlls)
    list(GET ngx_dlls 0 ngx_dll)
    file(COPY "${ngx_dll}" DESTINATION "${DEST}")
  endif()
endif()

foreach(name IN ITEMS Qt6Widgets.dll avformat-61.dll avcodec-61.dll avutil-59.dll platforms/qwindows.dll)
  if(NOT EXISTS "${DEST}/${name}")
    message(FATAL_ERROR "після розкладки немає ${DEST}/${name}")
  endif()
endforeach()
